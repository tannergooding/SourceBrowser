<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- msbuild-->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build" Version="18.9.6" />

    <!-- roslyn -->
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />

    <!-- roslyn analyzer -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />

    <!-- test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />

    <!-- TestCode fixture dependencies -->
    <PackageVersion Include="Selenium.WebDriver" Version="4.52.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="nunit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />

    <!-- other dependencies -->
    <PackageVersion Include="Basic.CompilerLog.Util" Version="0.9.66" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="MSBuild.StructuredLogger" Version="2.3.269" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />

    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />

    <PackageVersion Include="GuiLabs.Language.Xml" Version="1.2.120" />

    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.AzureAppServices" Version="10.0.14" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.14" />
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  
  <!-- dependencies for dotnet/source-browser projects -->
  <ItemGroup>
      <PackageVersion Include="Azure.Identity" Version="1.21.0" />
      <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
      <PackageVersion Include="Mono.Options" Version="6.12.0.148" />
      <PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
      <PackageVersion Include="SharpZipLib" Version="1.4.2" />
      <PackageVersion Include="System.Reflection.Metadata" Version="10.0.14" />
  </ItemGroup>

</Project>
